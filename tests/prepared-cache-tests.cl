;;; Load after CL-MAP. Fixtures: python3 tests/prepare-cache-fixtures.py /tmp/map-cache-tests
(in-package :cl-map)

(defun test-prepared-cache (&optional (directory #P"/tmp/map-cache-tests/"))
  "Check exact results, eviction, memory limits, separate maps, cleanup and concurrent clears."
  (let* ((map (load-map (merge-pathnames "land.shp" directory)))
         (other (load-map (merge-pathnames "other.shp" directory)))
         (cases (with-open-file (s (merge-pathnames "segments.sexp" directory)) (read s)))
         (reference nil) (*prepared-cache-enabled* t))
    (labels ((check (case &optional (map map))
               (destructuring-bind (x0 y0 x1 y1) case
                 (not (null (line-intersects-land-p (make-latlng :lat y0 :lng x0)
                                                   (make-latlng :lat y1 :lng x1) :map map)))))
             (compare () (assert (equal reference (mapcar #'check cases))))
             (budget () (let ((s (prepared-cache-statistics)))
                          (assert (<= (getf s :estimated-bytes) *prepared-cache-max-bytes*))
                          (assert (<= (getf s :entries) *prepared-cache-max-entries*)))))
      (unwind-protect
           (progn
             (assert (= (* 1000 1024 1024) *prepared-cache-max-bytes*))
             (let ((*prepared-cache-enabled* nil)) (setf reference (mapcar #'check cases)))
             (assert (equal (subseq reference 0 10) '(t t nil t t nil nil t t nil)))
             (compare) (compare) (budget)
             (let ((*prepared-cache-cell-size* 1)) (compare))
             (compare)
             ;; Strict point containment and exact rectangle semantics.
             (assert (is-land (make-latlng :lat .5d0 :lng .5d0) :map map))
             (assert (not (is-land (make-latlng :lat 1.5d0 :lng 1.5d0) :map map)))
             (assert (not (is-land (make-latlng :lat 0d0 :lng 0d0) :map map)))
             (assert (rectangle-intersects-land-p .2d0 .2d0 .8d0 .8d0 :map map))
             (assert (not (rectangle-intersects-land-p 1.2d0 1.2d0 1.8d0 1.8d0 :map map)))
             ;; Antimeridian crossings follow short segments on both sides.
             (assert (check '(179.5d0 1.5d0 -179.5d0 1.5d0)))
             (assert (not (check '(179.5d0 5d0 -179.5d0 5d0))))
             (assert (check '(-179.5d0 1.5d0 179.5d0 1.5d0)))
             (let ((*prepared-cache-max-bytes* 8192) (*prepared-cache-max-entries* 1)
                   (*prepared-cache-max-tiles* 1) (*prepared-cache-tile-bytes* 512))
               (compare) (budget)
               (assert (<= (getf (prepared-cache-statistics map) :tiles) 1)))
             (let ((*prepared-cache-max-bytes* 1)) (compare) (budget))
             (let ((*prepared-cache-max-bytes* 0)) (compare) (budget))
             ;; Lowering the budget also trims on coarse-only ocean queries.
             (assert (check '(-1d0 .5d0 .5d0 .5d0)))
             (let ((*prepared-cache-max-bytes* 0))
               (tile-intersects-land-p -1d0 -1d0 :map map)
               (assert (zerop (getf (prepared-cache-statistics) :entries))))
             ;; Feature IDs are local to each map; eviction uses a shared total budget.
             (assert (is-land (make-latlng :lat .5d0 :lng .5d0) :map map))
             (assert (not (is-land (make-latlng :lat .5d0 :lng .5d0) :map other)))
             (assert (is-land (make-latlng :lat .5d0 :lng 40.5d0) :map other))
             (let ((before (getf (prepared-cache-statistics) :entries)))
               (clear-map-cache map)
               (assert (< (getf (prepared-cache-statistics) :entries) before))
               (assert (plusp (getf (prepared-cache-statistics other) :entries))))
             (close-map other) (close-map other)
             (compare)
             ;; Failed replacement is transactional and leaves the original usable.
             (let ((*map* map))
               (assert (handler-case (progn (ensure-map :filename "/tmp/nonexistent-cl-map-cache-test.shp" :reload t) nil)
                         (error () t)))
               (assert (eq *map* map))
               (assert (check '(-1d0 .5d0 .5d0 .5d0))))
             ;; Nearest-intersection queries own geometry, including early returns.
             (multiple-value-bind (hit point)
                 (line-land-intersection (make-latlng :lat .5d0 :lng -1d0)
                                         (make-latlng :lat .5d0 :lng .5d0) :map map)
               (assert hit) (assert (< (abs (latlng-lng point)) 1d-9)))
             (assert (not (line-land-intersection (make-latlng :lat -1d0 :lng -2d0)
                                                  (make-latlng :lat -1d0 :lng -1d0) :map map)))
             ;; Empty coarse cells are cached; full-cell tests include tile boundaries.
             (assert (not (tile-intersects-land-p -1d0 -1d0 :map map)))
             (assert (tile-intersects-land-p .1d0 .1d0 :map map))
             (assert (<= (getf (prepared-cache-statistics map) :coarse-bytes) (* 2 1024 1024)))
             ;; The global map lock serializes prepared handles, evictions and clears.
             (let ((errors nil) (lock (bt:make-lock "cache-test-errors")) (threads nil))
               (dotimes (n 4)
                 (push (bt:make-thread
                         (lambda ()
                           (handler-case
                               (dotimes (i 100)
                                 (assert (check '(-1d0 .5d0 .5d0 .5d0)))
                                 (assert (not (check '(1.2d0 1.2d0 1.8d0 1.8d0)))))
                             (error (e) (bt:with-lock-held (lock) (push e errors)))))) threads))
               (dotimes (i 20) (clear-map-cache map))
               (dolist (thread threads) (bt:join-thread thread))
               (assert (null errors)))
             (budget)
             (clear-map-cache map)
             (assert (zerop (getf (prepared-cache-statistics) :estimated-bytes)))
             ;; Explicit reload replaces/cleans the old active map transactionally.
             (let ((*map* map))
               (ensure-map :filename (merge-pathnames "land.shp" directory) :reload t)
               (assert (mapp-closed map))
               (assert (not (eq *map* map)))
               (close-map))
             (assert (handler-case (progn (check '(0d0 0d0 1d0 1d0)) nil) (error () t))))
        (close-map map) (close-map other))))
  (format t "~&Prepared cache correctness, global budget, eviction, ownership, reload and concurrency tests passed.~%"))
